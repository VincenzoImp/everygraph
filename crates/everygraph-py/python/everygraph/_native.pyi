"""The native module (crates/everygraph-py/src). Private: the package wraps it."""

from collections.abc import Callable
from typing import Any

__version__: str

OnEvent = Callable[[str, str, int | None, float], None]

class NativeError(Exception): ...

class Table:
    num_rows: int
    columns: list[str]
    def head(self, n: int) -> Table: ...
    def top(self, n: int, by: str) -> Table: ...
    def sizes(self, column: str) -> Table: ...
    def rows(self, start: int, stop: int) -> list[tuple[Any, ...]]: ...
    def schema_capsule(self, meta: str | None = None) -> object: ...
    def stream_capsule(self, meta: str | None = None) -> object: ...

class Graph:
    num_nodes: int
    num_edges: int
    directed: bool
    file: str | None
    bytes: int
    pages: tuple[str, bool]
    def nodes(self) -> Table: ...
    def lookup(self, keys: list[Any]) -> list[int | None]: ...
    def pagerank(
        self, damping: float, tol: float, max_iter: int, weight: bool,
        personalize: list[int] | None, low: bool, memory: int, threads: int, on_event: OnEvent,
    ) -> tuple[Table, dict[str, Any]]: ...
    def bfs(
        self, source: int, direction: str, max_hops: int | None, memory: int, threads: int,
        on_event: OnEvent,
    ) -> tuple[Table, dict[str, Any]]: ...
    def components(self, memory: int, threads: int, on_event: OnEvent) -> tuple[Table, dict[str, Any]]: ...
    def kcore(self, memory: int, threads: int, on_event: OnEvent) -> tuple[Table, dict[str, Any]]: ...
    def degrees(
        self, nodes: list[int] | None, memory: int, threads: int, on_event: OnEvent,
    ) -> tuple[Table, dict[str, Any]]: ...

def open(path: object, memory: int) -> Graph: ...
def inspect(path: str, **asked: Any) -> dict[str, Any]: ...
def read(path: str, **asked: Any) -> tuple[Graph, dict[str, Any]]: ...
def machine_memory() -> tuple[int, int] | None: ...
def default_threads() -> int: ...
