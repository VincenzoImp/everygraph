"""The native module (crates/everygraph-py/src). Private: the package wraps it."""

from collections.abc import Callable
from typing import Any

__version__: str

OnEvent = Callable[[str, str, int | None, float, int], None]
# The budget and its origin, the most threads and theirs, and whether only to plan.
Run = tuple[int | None, str, int | None, str, bool]
# The table (None for a dry run) and what its meta gains, with `plan` and `plan_text`.
Called = tuple["Table | None", dict[str, Any]]

class NativeError(Exception): ...

class Table:
    num_rows: int
    columns: list[str]
    def head(self, n: int) -> Table: ...
    def top(self, n: int, by: str) -> Table: ...
    def sizes(self, column: str) -> Table: ...
    def rows(self, start: int, stop: int) -> list[tuple[Any, ...]]: ...
    def schema_capsule(self, meta: str | None = None) -> object: ...
    def stream_capsule(self, meta: str | None = None) -> object: ...

class Graph:
    num_nodes: int
    num_edges: int
    directed: bool
    file: str | None
    bytes: int
    pages: tuple[str, bool]
    def nodes(self) -> Table: ...
    def lookup(self, keys: list[Any]) -> list[int | None]: ...
    def pagerank(
        self, damping: float, tol: float, max_iter: int, edges: bool,
        personalize: list[int] | None, low: bool, run: Run, on_event: OnEvent,
    ) -> Called: ...
    def bfs(self, source: int, direction: str, max_hops: int | None, run: Run, on_event: OnEvent) -> Called: ...
    def components(self, strong: bool, run: Run, on_event: OnEvent) -> Called: ...
    def kcore(self, run: Run, on_event: OnEvent) -> Called: ...
    def degrees(self, nodes: list[int | None] | None, run: Run, on_event: OnEvent) -> Called: ...

def open(path: object, memory: int) -> Graph: ...
def inspect(path: str, **asked: Any) -> dict[str, Any]: ...
def read(path: str, **asked: Any) -> tuple[Graph, dict[str, Any]]: ...
def machine_memory() -> tuple[int, int] | None: ...
def default_threads() -> int: ...
def job_id(parts: list[str]) -> str: ...
def about(seconds: float) -> str: ...
